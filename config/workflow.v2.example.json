{
  "version": 2,
  "name": "example-gui-workflow",
  "target": {
    "title_pattern": "示例应用",
    "class_name": null
  },
  "settings": {
    "stop_on_error": true,
    "default_timeout_ms": 10000,
    "auto_delay": {
      "mode": "none",
      "fixed_ms": 500,
      "min_ms": 300,
      "max_ms": 800
    }
  },
  "steps": [
    {
      "id": "find-document",
      "type": "template_match",
      "name": "识别文本文档",
      "on_failure": "retry",
      "template": "assets/resource/image/replace-with-document-template.png",
      "threshold": 0.8,
      "attempts": 3,
      "interval_ms": 500,
      "result_variable": "document",
      "post_action": "none"
    },
    {
      "id": "open-document",
      "type": "mouse_click",
      "name": "双击文本文档",
      "match_variable": "document",
      "button": "left",
      "count": 2,
      "interval_ms": 100
    },
    {
      "id": "wait-for-editor",
      "type": "wait",
      "name": "延迟等待编辑器打开",
      "delay_mode": "fixed",
      "duration_ms": 1000
    },
    {
      "id": "type-marker",
      "type": "text_input",
      "name": "输入测试文本",
      "text": "Window automation input verification",
      "strategy": "key_sequence",
      "interval_ms": 80
    },
    {
      "id": "save",
      "type": "key_press",
      "name": "保存文件",
      "key": "S",
      "modifiers": ["CTRL"],
      "hold_ms": 80
    }
  ]
}
